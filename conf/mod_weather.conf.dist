[worldserver]

########################################
# mod-weather
#
# Weather that comes in fronts: neighbouring zones share a front, which builds up, peaks, tapers
# off and is followed by a dry spell. Each zone turns the front into its own climate (rain, snow
# or sandstorm). On top: fog, mist after rain, thunderstorms, black rain and black snow in the
# zones listed in `mod_weather_zone`. Regions and city strength are in `mod_weather_region`.
#
# While the module runs it takes the weather over from the core: it sets ChangeWeatherInterval
# so long that the core stops rolling (Isle of Quel'Danas still rolls on the original interval,
# because the Sunwell event drives it). ActivateWeather still turns all weather off.
########################################

#
#    Weather.Enable
#        Description: Run the weather as fronts. Off, weather is stock AzerothCore (zones still
#                     use the module's `game_weather` rows, that's plain SQL). Changing this
#                     needs a restart.
#        Default:     1
#

Weather.Enable = 1

#
#    Weather.FrontInterval
#        Description: Once a region's dry spell is over, how often, in minutes, it rolls for a
#                     new front. The chance is the region's wettest zone's `game_weather` chance
#                     for the season. Minimum 1.
#        Default:     10
#

Weather.FrontInterval = 10

#
#    Weather.BuildUpMin, Weather.BuildUpMax
#    Weather.PeakMin,    Weather.PeakMax
#    Weather.TaperMin,   Weather.TaperMax
#    Weather.DryMin,     Weather.DryMax
#        Description: How long, in minutes, each part of a front lasts: a random time between
#                     Min and Max. A front builds up from nothing, holds its peak (drifting a
#                     little, like gusts), tapers off, then the region stays dry for at least the
#                     dry spell before it can roll again.
#        Default:     3, 6, 10, 25, 5, 8, 20, 60
#

Weather.BuildUpMin = 3
Weather.BuildUpMax = 6
Weather.PeakMin    = 10
Weather.PeakMax    = 25
Weather.TaperMin   = 5
Weather.TaperMax   = 8
Weather.DryMin     = 20
Weather.DryMax     = 60

#
#    Weather.MediumChance, Weather.HeavyChance
#        Description: Percent of fronts that peak at medium and at heavy. The rest stay light.
#                     Thunderstorms only happen at heavy.
#        Default:     30, 10
#

Weather.MediumChance = 30
Weather.HeavyChance  = 10

#
#    Weather.FaintGrade
#        Description: The faintest weather the module draws, from 0.01 to 0.27. The core sends
#                     anything under 0.27 as clear skies; the module sends it as light weather
#                     so fronts start and end with a drizzle instead of popping in at 0.27. If
#                     the client draws nothing that faint, raise this. Continents only: zones
#                     inside instances go through the core and start at 0.27.
#        Default:     0.10
#

Weather.FaintGrade = 0.10

#
#    Weather.Fog
#        Description: Roll fog under clear skies in zones with a `fog_chance`. Only works on
#                     continents, not inside instances.
#        Default:     1
#

Weather.Fog = 1

#
#    Weather.FogInterval
#        Description: How often, in seconds, a clear zone rolls its `fog_chance`. The fog (or
#                     clear sky) lasts until the next roll, or until a front arrives.
#                     Minimum 60.
#        Default:     600
#

Weather.FogInterval = 600

#
#    Weather.MistAfterRain
#        Description: When a front ends in a zone with a `fog_chance`, mist can settle for a few
#                     minutes, at twice the zone's fog chance. Needs Weather.Fog.
#        Default:     1
#

Weather.MistAfterRain = 1

#
#    Weather.Thunderstorms
#        Description: Let heavy rain become a thunderstorm in zones with a `thunder_chance`. Each
#                     front rolls it once per zone; the thunder comes while the rain is heavy.
#        Default:     1
#

Weather.Thunderstorms = 1

#
#    Weather.BlackRain
#        Description: Rain falls as black rain in zones with `black_rain` set.
#        Default:     1
#

Weather.BlackRain = 1

#
#    Weather.BlackSnow
#        Description: Snow falls as black snow in zones with `black_snow` set. Only works on
#                     continents, not inside instances.
#        Default:     1
#

Weather.BlackSnow = 1

#
#    Weather.Overcast
#        Description: Grey the sky while a zone has rain, snow or a sandstorm: a light laid over
#                     the player's own lighting, darker the heavier the weather (thunderstorms,
#                     black rain and black snow darkest), faded in and out a step at a time.
#                     Continents only. Needs a client patch with the rows of
#                     `mod_weather_overcast`, which belong to one patch (see the README): turn it
#                     on only when your players have that patch. With mod-night-brightness in
#                     the same server the overcast goes through it and follows each player's
#                     night brightness.
#        Default:     0
#

Weather.Overcast = 0

#
#    Weather.OvercastLight, Weather.OvercastHeavy
#        Description: How far the sky is pulled toward the overcast's colours, from 0 (not at
#                     all) to 1 (all the way): at the faintest weather drawn (Weather.FaintGrade)
#                     and at the heaviest. In between it follows the weather's strength. The
#                     client patch has steps from 0.05 to 0.90.
#        Default:     0.15, 0.80
#

Weather.OvercastLight = 0.15
Weather.OvercastHeavy = 0.80
